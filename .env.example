# Copy to `.env` for local development, and set the same values in
# Vercel → Settings → Environment Variables for the deployed app.
#
# These ship in the client bundle by design: RLS plus a private HOUSEHOLD
# phrase are the security model for a family app. The service_role key and the
# VAPID PRIVATE key are the only real secrets — they must never appear here.

# From Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# A long private phrase. BOTH phones must set this to EXACTLY the same value or
# they will silently not see each other's entries.
VITE_HOUSEHOLD=change-me-to-a-long-private-phrase

# Optional. Leave blank unless you have set up push notifications (§12).
VITE_VAPID_PUBLIC_KEY=
