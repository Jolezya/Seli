{
  "name": "ChEckIn",
  "short_name": "ChEckIn",
  "description": "Track a newborn's feeds, sleep, diapers and weight.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F1F6",
  "theme_color": "#F2F1F6",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log wet diaper", "short_name": "Wet", "url": "/?log=wet", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log poop diaper", "short_name": "Poop", "url": "/?log=poop", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log a feed", "short_name": "Feed", "url": "/?log=nurse", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
